#!/bin/bash

if ! command -v gh &>/dev/null; then
  echo "⚠️  gh CLI가 설치되지 않아 AI 리뷰를 건너뜁니다."
  exit 0
fi

BRANCH=$(git branch --show-current)

PR_NUMBER=$(gh pr view "$BRANCH" --json number -q '.number' 2>/dev/null)
if [ -z "$PR_NUMBER" ]; then
  exit 0
fi

echo "🤖 AI 코드 리뷰 시작 (PR #$PR_NUMBER)..."

TMPFILE=$(mktemp /tmp/pr-review-XXXXXX.txt)
trap 'rm -f "$TMPFILE"' EXIT

gh pr diff "$PR_NUMBER" > "$TMPFILE" 2>/dev/null
if [ ! -s "$TMPFILE" ]; then
  echo "변경 사항 없음, 리뷰 건너뜀"
  exit 0
fi

# 줄 단위로 자름 (바이트 절단으로 인한 UTF-8 깨짐 방지)
DIFF=$(head -n 300 "$TMPFILE")

PROMPT="아래 PR diff를 한국어로 코드 리뷰해줘.
프로젝트 스택: Next.js 14 (App Router), TypeScript (strict), Supabase

다음 포맷으로 작성해줘:

## 🤖 AI Code Review

> **심각도 요약**: 🔴 Critical: N | 🟡 Important: N | 💡 Suggestion: N

## 🔴 Critical Issues
### [CRITICAL] 제목
- **파일**: \`경로/파일.ts\` (line X)
- **문제**: 설명
- **수정 방법**: 구체적 해결책

## 🟡 Important Issues
(동일 포맷)

## 💡 Suggestions
(동일 포맷)

## ✅ 잘된 점
- 긍정적인 부분 1~3개

이슈가 없는 섹션은 \"없음\"으로 표시해줘.
보안 취약점(특히 Supabase RLS, API route 인증), TypeScript 타입 안전성, Next.js Server/Client 경계를 중점적으로 확인해줘.
텍스트만 출력하고 파일 시스템이나 외부 도구는 사용하지 마.

--- PR DIFF ---
$DIFF"

REVIEW=$(echo "$PROMPT" | claude -p --allowedTools "" 2>/dev/null)

if [ -z "$REVIEW" ]; then
  echo "❌ 리뷰 생성 실패"
  exit 0
fi

gh pr comment "$PR_NUMBER" --body "$REVIEW"
echo "✅ PR #$PR_NUMBER 에 리뷰 코멘트 게시 완료"
